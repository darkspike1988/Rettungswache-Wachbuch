# Pflicht: unabhaengige Zufallswerte, z. B. openssl rand -hex 32
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
POSTGRES_DB=rwsth
POSTGRES_USER=rwsth_owner
POSTGRES_PASSWORD=replace-with-a-random-owner-password
APP_DB_USER=rwsth_app
APP_DB_PASSWORD=replace-with-a-random-app-password
FEED_DB_USER=rwsth_feed
FEED_DB_PASSWORD=replace-with-a-random-feed-password
FEED_WORKER_SECRET_KEY=replace-with-an-independent-random-value

# Lokaler HTTP-Schnellstart auf Loopback. Fuer TLS hinter Reverse-Proxy:
# SECURE_COOKIES=true und echte Hostnamen in ALLOWED_HOSTS / CSRF_TRUSTED_ORIGINS.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8090
DJANGO_DEBUG=false
SECURE_COOKIES=false
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8090

DEFAULT_STATION_NAME=Rettungswache
DEFAULT_STATION_SLUG=rettungswache
APP_NAME=Wachbuch
SOURCE_URL=https://github.com/Darkspike1988/Rettungswache-Wachbuch

# Demo-Modus: Musterkonten + Beispieldaten (nur lokal/Vorführung, nie produktiv)
DEMO_MODE=false
DEMO_PASSWORD=Demo-Passwort-12345

# Kommagetrennte HTTPS-Hosts fuer optionale externe Quellen
FEED_ALLOWED_HOSTS=

# Aufbewahrung: Feed-Eintraege ohne Last-Seen; Audit nur nach Freigabe (0=aus)
RETENTION_FEED_DAYS=90
RETENTION_AUDIT_DAYS=0

# TOTP-Zweitfaktor (Authenticator-App); MFA_REQUIRED erzwingt Einrichtung nach Login
MFA_ENABLED=true
MFA_REQUIRED=false

# Oeffentliche Selbstregistrierung optional; Standard: Master-Admin legt Nutzer an
REGISTRATION_ENABLED=false
REGISTRATION_RATE_LIMIT=5

# Passkeys (WebAuthn) – RP_ID ohne Schema, ORIGIN mit https://
WEBAUTHN_ENABLED=true
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# Web-Push fuer dringende Uebergaben (VAPID-Schluessel noetig)
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=ops@example.org

BACKUP_UID=70
BACKUP_GID=70
