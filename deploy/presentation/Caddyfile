:8080 {
  root * /srv
  header {
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    X-Robots-Tag "noindex, nofollow, noarchive"
    Cache-Control "no-cache"
  }
  file_server
}
